{
  "name": "magictester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "tsc && npm run build -w apps/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests apps/web/app scripts",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:runner": "tsx watch src/runner.ts",
    "dev:web": "npm run dev -w apps/web",
    "bootstrap": "node scripts/bootstrap.mjs",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "spike": "tsx scripts/spike.ts",
    "test:integration": "node scripts/smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "bullmq": "^6.7.1",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.0",
    "playwright": "^1.65.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
