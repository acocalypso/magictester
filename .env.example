# Copy to .env. The default deployment binds only to localhost.
POSTGRES_PASSWORD=magictester-local
# Required only for snapshot imports. Generate using: openssl rand -hex 32
ADMIN_TOKEN=
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
MAX_GAMES_PER_JOB=1000
SIMULATION_CONCURRENCY=1
MAX_FORGE_PROCESSES=1
MAX_JOB_RUNTIME_SECONDS=21600
FORGE_HEAP=1024m
RUNNER_MEMORY=2g
RUNNER_CPUS=2
