# Copy to .env. The default deployment binds only to localhost.
POSTGRES_PASSWORD=magictester-local
# Required only for snapshot imports. Generate using: openssl rand -hex 32
ADMIN_TOKEN=
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
MAX_GAMES_PER_JOB=1000
# 0 selects resource-based analysis and match concurrency.
SIMULATION_CONCURRENCY=0
MAX_FORGE_PROCESSES=0
MAX_JOB_RUNTIME_SECONDS=21600
FORGE_HEAP=1024m
# Optional Docker ceilings: 0 lets the resource governor size against the VM/host.
RUNNER_MEMORY=0
RUNNER_CPUS=0
FORGE_CPUS_PER_PROCESS=2
FORGE_MEMORY_OVERHEAD_MB=512
# 0 reserves 15% of effective RAM (256 MiB minimum, 2 GiB maximum).
FORGE_MEMORY_RESERVE_MB=0
FORGE_BATCH_SIZE=50

# HTTPS hosts serving feeds you own or have permission to poll. No redirects.
META_FEED_HOSTS=raw.githubusercontent.com

CARD_REFRESH_HOURS=24
LOG_FILE_MB=8
LOG_TOTAL_MB=512
LOG_MAX_FILES=500
LOG_RETENTION_DAYS=7

# Daily ranked opponent pools for every format; each pool retains source provenance.
DAILY_META_ENABLED=true
DAILY_META_DECKS=10

# Stable Forge release check interval (hours). Candidates must pass native contracts and games.
FORGE_CHECK_HOURS=1
